# Sito — .env.production
# Copia questi valori nelle Environment Variables di Vercel
# (Settings → Environment Variables → Production).

# ===== Supabase =====
# Crea un project su https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TUO_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TUO_ANON_KEY

# ===== Stripe (server-side only — NON esporre nel client) =====
STRIPE_SECRET_KEY=sk_live_TUO_STRIPE_SECRET
STRIPE_PRICE_ID_PERPETUAL=price_TUO_PRICE_ID

# ===== Public site URL =====
NEXT_PUBLIC_SITE_URL=https://www.dcs-ai-atc.com

# ===== Backend licensing API (chiamato dal sito per /account, /download) =====
# Il sito chiama il backend per: login, license status, download URL
NEXT_PUBLIC_API_BASE_URL=https://api.dcs-ai-atc.com

# ===== Optional =====
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=tuo_codice
# AUTH_COOKIE_DOMAIN=.dcs-ai-atc.com
